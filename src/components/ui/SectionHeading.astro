---
interface Props {
  title: string;
  subtitle?: string;
  id: string;
  level?: 2 | 3;
}

const { title, subtitle, id, level = 2 } = Astro.props;
const Tag = `h${level}` as 'h2' | 'h3';
---

<div class="mx-auto max-w-2xl text-center">
  <Tag id={id} class="font-display text-3xl font-bold tracking-tight text-neutral-900 sm:text-4xl">
    {title}
  </Tag>
  {subtitle && <p class="mt-4 text-lg text-neutral-600">{subtitle}</p>}
</div>
