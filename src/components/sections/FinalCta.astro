---
import { getSection } from '../../lib/sections';
import Button from '../ui/Button.astro';
import Container from '../ui/Container.astro';

const data = await getSection('cta');
const buttonClass = {
  primary: 'bg-white !text-primary-800 hover:bg-primary-50',
  secondary: 'border-white !text-white hover:bg-primary-900',
};
---

{data && (
  <section id="cta" aria-labelledby="cta-title" class="bg-primary-800 py-16 sm:py-20">
    <Container class="text-center">
      <h2 id="cta-title" class="font-display text-3xl font-bold text-white sm:text-4xl">
        {data.title}
      </h2>
      {data.description && (
        <p class="mx-auto mt-4 max-w-2xl text-lg text-white">{data.description}</p>
      )}
      {data.buttons.length > 0 && (
        <div class="mt-8 flex flex-wrap justify-center gap-4">
          {data.buttons.map((button) => (
            <Button
              href={button.href}
              size="lg"
              variant={button.variant}
              class={buttonClass[button.variant]}
            >
              {button.label}
            </Button>
          ))}
        </div>
      )}
    </Container>
  </section>
)}
