---
import { Icon } from 'astro-icon/components';
import { getSection } from '../../lib/sections';
import Container from '../ui/Container.astro';
import SectionHeading from '../ui/SectionHeading.astro';

const data = await getSection('features');
---

{data && (
  <section id="features" aria-labelledby="features-title" class="py-16 sm:py-24">
    <Container>
      <SectionHeading id="features-title" title={data.title} subtitle={data.subtitle} />
      <ul class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {data.items.map((item) => (
          <li class="rounded-card shadow-card bg-white p-6">
            <span class="bg-primary-50 text-primary-700 inline-flex size-12 items-center justify-center rounded-lg">
              <Icon name={`lucide:${item.icon}`} class="size-6" aria-hidden="true" />
            </span>
            <h3 class="font-display mt-4 text-lg font-semibold text-neutral-900">{item.title}</h3>
            <p class="mt-2 text-neutral-600">{item.description}</p>
          </li>
        ))}
      </ul>
    </Container>
  </section>
)}
