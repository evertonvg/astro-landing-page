---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../layout/Header.astro';
import Footer from '../layout/Footer.astro';
import Container from '../ui/Container.astro';
import CookieTable from './CookieTable.astro';

interface Props {
  slug: 'privacidade' | 'termos';
}

const { slug } = Astro.props;
const entry = await getEntry('legal', slug);
if (!entry) throw new Error(`Missing legal content (src/content/legal/${slug}.md)`);
const { Content } = await render(entry);
const { title, description, updatedAt } = entry.data;
const updated = new Intl.DateTimeFormat('pt-BR', { dateStyle: 'long', timeZone: 'UTC' }).format(
  updatedAt,
);
---

<BaseLayout title={title} description={description}>
  <Header slot="header" />
  <Container class="py-12 md:py-16">
    <article class="prose prose-neutral mx-auto max-w-3xl">
      <h1>{title}</h1>
      <p>
        Última atualização: <time datetime={updatedAt.toISOString().slice(0, 10)}>{updated}</time>
      </p>
      <Content />
      {slug === 'privacidade' && <CookieTable />}
    </article>
  </Container>
  <Footer slot="footer" />
</BaseLayout>
