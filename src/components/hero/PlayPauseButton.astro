---
import { Icon } from 'astro-icon/components';
import { t } from '../../i18n/pt-BR';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const buttonClass =
  'pointer-events-auto flex size-9 items-center justify-center rounded-full bg-white text-neutral-900 shadow hover:bg-neutral-100';
---

<!-- Needs `canPause`, `playing` and `togglePlay()` from the enclosing carousel / heroVideo scope. -->
<button
  type="button"
  x-show="canPause && playing"
  x-cloak
  class:list={[buttonClass, className]}
  aria-label={t.carousel.pause}
  @click="togglePlay()"
>
  <Icon name="lucide:pause" class="size-5" aria-hidden="true" />
</button>
<button
  type="button"
  x-show="canPause && !playing"
  x-cloak
  class:list={[buttonClass, className]}
  aria-label={t.carousel.play}
  @click="togglePlay()"
>
  <Icon name="lucide:play" class="size-5" aria-hidden="true" />
</button>
