---
import { Icon } from 'astro-icon/components';
import { t } from '../../i18n/pt-BR';
import { site } from '../../site.config';
import { getSection, pageHref } from '../../lib/sections';
import Container from '../ui/Container.astro';

const footer = await getSection('footer');
if (!footer) throw new Error('Missing footer section content (src/content/sections/footer.yaml)');

const { pathname } = Astro.url;
const copyright = footer.copyright.replace('{year}', String(new Date().getFullYear()));
---

<footer class="bg-neutral-900 text-neutral-300" aria-label={t.common.footerLabel}>
  <Container class="py-12">
    <div class="grid gap-10 md:grid-cols-3">
      <div>
        <p class="font-display text-xl font-bold text-white">{site.name}</p>
        <p class="mt-3 max-w-xs text-sm">{site.description}</p>
        {site.social.length > 0 && (
          <ul class="mt-5 flex gap-3" aria-label={t.common.socialLabel}>
            {site.social.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-label={item.label}
                  rel="noopener noreferrer"
                  target="_blank"
                  class="inline-flex size-10 items-center justify-center rounded-lg hover:bg-neutral-800 hover:text-white"
                >
                  <Icon name={item.icon} class="size-5" aria-hidden="true" />
                </a>
              </li>
            ))}
          </ul>
        )}
      </div>
      {footer.columns.map((column) => (
        <div>
          <h2 class="text-sm font-semibold tracking-wide text-white uppercase">{column.title}</h2>
          <ul class="mt-4 space-y-2 text-sm">
            {column.links.map((link) => (
              <li>
                <a href={pageHref(link.href, pathname)} class="hover:text-white hover:underline">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <div class="mt-10 flex flex-col gap-4 border-t border-neutral-700 pt-6 text-sm sm:flex-row sm:items-center sm:justify-between">
      <p>{copyright}</p>
      <button
        type="button"
        data-cc="show-preferencesModal"
        class="self-start rounded underline hover:text-white sm:self-auto"
      >
        {t.common.cookiePreferences}
      </button>
    </div>
  </Container>
</footer>
