# Public URL of the site (used for canonical URLs, sitemap and OG tags)
PUBLIC_SITE_URL=http://localhost:4321
# Firebase web app config (Project settings > General > Your apps)
PUBLIC_FIREBASE_API_KEY=demo-api-key
PUBLIC_FIREBASE_AUTH_DOMAIN=demo-landing.firebaseapp.com
PUBLIC_FIREBASE_PROJECT_ID=demo-landing
PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000
# reCAPTCHA v3 site key used by Firebase App Check
PUBLIC_RECAPTCHA_SITE_KEY=demo-recaptcha-site-key
# Google Tag Manager container id (optional; leave empty to disable)
PUBLIC_GTM_ID=
# Use the local Firebase emulators instead of a real project (true/false)
PUBLIC_USE_FIREBASE_EMULATOR=true
