    "@astrojs/sitemap": "3.7.4",
    "@fontsource-variable/inter": "5.3.0",
    "@iconify-json/lucide": "1.2.147",
    "@tailwindcss/vite": "4.3.3",
    "alpinejs": "3.17.4",
    "astro": "7.4.1",
    "astro-icon": "1.2.0",
    "embla-carousel": "8.6.0",
    "embla-carousel-autoplay": "8.6.0",
    "embla-carousel-fade": "8.6.0",
    "firebase": "13.0.0",
